# Copy to .env and fill in. Never commit .env.

# Same LiveKit Cloud project as the backend.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Where the FastAPI backend runs, e.g. http://localhost:8000 or your Render address.
API_URL=
# Must match VOICE_WORKER_KEY in backend/.env.
VOICE_WORKER_KEY=

# Optional: models used through LiveKit Inference (billed to your LiveKit project,
# so no separate STT/LLM/TTS keys are needed). Leave blank for the defaults in agent.py.
STT_MODEL=
LLM_MODEL=
TTS_MODEL=
