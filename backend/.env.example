# Copy to .env and fill in. Never commit .env.

# Local default is SQLite. For Neon, paste the connection string from Neon's
# Connect box as is (postgresql://... is fine). Keep it private: it contains the password.
DATABASE_URL=

# Long random string used to sign log-in tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of sites allowed to call the API, e.g. http://localhost:5173
CORS_ORIGINS=

# LiveKit Cloud project (voice quiz). Leave blank until you set up LiveKit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared secret between this API and the voice-quiz worker (voice_agent/.env). Any long random string.
VOICE_WORKER_KEY=

# "Sign in with Google". Create an OAuth client (type: Web application) in Google Cloud
# Console and add this API's callback as an authorised redirect URI:
#   https://<your-api-host>/api/fde/auth/google/callback   (locally http://localhost:8000/...)
# Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The site's address, where people land after Google sign-in. Defaults to the first CORS origin.
FRONTEND_URL=

# God mode (admin dashboard at /god). Comma-separated emails allowed in. They must sign in
# with Google; a password log-in with the same email is refused. Set it on the host only.
ADMIN_EMAILS=

# Limit the site to certain email domains, comma-separated, e.g. revrag.ai. Blank = anyone.
# When set, new accounts can only be made with Sign in with Google, and ADMIN_EMAILS are always allowed.
ALLOWED_EMAIL_DOMAINS=
